{
  "name": "aavirbhav/razorpay-integration",
  "description": "Razorpay PHP Integration for Aavirbhav",
  "type": "project",
  "require": {
    "php": ">=7.4",
    "razorpay/razorpay": "^2.9",
    "rmccue/requests": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "scripts": {
    "post-install-cmd": [
      "clear-composer-cache",
      "optimize-autoload"
    ],
    "post-update-cmd": [
      "clear-composer-cache",
      "optimize-autoload"
    ],
    "clear-composer-cache": [
      "composer clear-cache"
    ],
    "optimize-autoload": [
      "dump-autoload -o"
]
}
}